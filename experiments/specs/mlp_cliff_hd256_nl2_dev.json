  "evaluation": {
    "kind": "alpha_level_suite",
    "levels": [2, 3, 4, 5, 6, 7, 8, 9, 10],
    "games_per_shard": 50,
    "seed_start": 0,
    "seed_end": 200,
    "service_host": "127.0.0.1",
    "service_port": 8042,
    "mcts_simulations": 64,
    "mcts_max_depth": 16,
    "mcts_cpuct": 1.5
  }
}