{
  "api_version": "v1",
  "experiment_id": "alpha-phase4-demo",
  "description": "Phase 4 sharded AlphaSolitaire evaluation and reporting demo.",
  "architecture": {
    "family": "mlp",
    "params": {
      "hidden_dim": 256,
      "num_layers": 2,
      "batch_norm": false,
      "residual": false
