{
  "api_version": "v1",
  "experiment_id": "mlp-fresh-data-demo",
  "description": "Collect fresh episode logs, train an MLP on the collected logs from the same run, and evaluate the resulting checkpoint.",
  "architecture": {
    "family": "mlp",
    "params": {
      "hidden_dim": 256,
      "num_layers": 2,
      "batch_norm": false,
      "residual": false
    }
  },
  "collection": {
    "kind": "endgame_level_dataset",
    "level": 2,
    "shard_count": 1,
    "games_per_shard": 5,
    "randomise": false,
    "seed_base": 2000
  },
  "dataset": {
    "kind": "run_collection_episode_logs"
  },
  "training": {
    "kind": "mlp_policy_value",
    "epochs": 1,
    "batch_size": 8,
    "learning_rate": 0.001,
    "checkpoint_every_epochs": 1,
    "checkpoint_prefix": "policy_value_fresh_data_demo",
    "metrics_filename": "epoch_metrics.jsonl",
    "resume_from": null
  },
  "evaluation": {
    "kind": "alpha_level_suite",
    "level": 2,
    "games_per_shard": 1,
    "seed_start": 0,
    "seed_end": 1,
    "service_host": "127.0.0.1",
    "service_port": 8014,
    "mcts_simulations": 8,
    "mcts_max_depth": 8,
    "mcts_cpuct": 1.5,
    "duckdb_filename": "evaluation.duckdb",
    "queries_filename": "evaluation_queries.sql",
    "shards_parquet_filename": "evaluation_shards.parquet",
    "rollups_parquet_filename": "evaluation_rollups.parquet",
    "report_markdown_filename": "evaluation_report.md"
  }
}